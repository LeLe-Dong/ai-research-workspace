# AI Research Workspace - backend env vars
# Copy this file to .env and fill in real values.
# ⚠️  DO NOT COMMIT .env — it contains secrets.

# Database
AIRW_DB_PATH=storage/airw.db

# Agent mode (mock / llm / hermes-researcher)
AIRW_AGENT_MODE=mock

# Stepfun / OpenAI-compatible LLM
AIRW_STEPFUN_API_KEY=REPLACE_WITH_YOUR_KEY
AIRW_STEPFUN_MODEL=step-3.7-flash
AIRW_STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1

# MiniMax web_search (Chinese-first search)
AIRW_MINIMAX_API_KEY=REPLACE_WITH_YOUR_KEY
AIRW_MINIMAX_BASE_URL=https://api.minimaxi.com

# Fernet key for encrypting K8s secrets
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRW_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
